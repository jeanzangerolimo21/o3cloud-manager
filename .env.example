# Flask
FLASK_ENV=development
SECRET_KEY=CHANGE_ME

# Banco
DB_HOST=localhost
DB_PORT=3306
DB_NAME=o3cloud_manager
DB_USER=o3manager
DB_PASSWORD=CHANGE_ME
# Opcional: caminho absoluto se o servico nao localizar o binario pelo PATH
MYSQLDUMP_PATH=/usr/bin/mysqldump

# OMIE
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Proxmox
PROXMOX_VERIFY_SSL=False

# Logs
LOG_LEVEL=INFO

# URL publica usada nos links de compartilhamento temporario
PUBLIC_BASE_URL=https://app.exemplo.com
EMAIL_MARKETING_LOGO_URL=https://o3cloud.com.br/wp-content/uploads/2025/04/Ativo-3.png
# Deve ser publico para imagens inseridas no corpo do email
EMAIL_MARKETING_PUBLIC_BASE_URL=https://app.exemplo.com
TRUST_PROXY=1
PROXY_FIX_HOPS=1
COFRE_COMPARTILHAMENTO_TTL_MINUTOS=5

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# O3Cloud Manager - processa sincronismos agendados salvos no banco.
# Instalar com: crontab deployment/o3cloud-manager.cron
*/5 * * * * cd /opt/o3cloud-manager && mkdir -p /tmp/o3cloud-manager-logs && O3_LOG_DIR=/tmp/o3cloud-manager-logs /opt/o3cloud-manager/venv/bin/flask --app app:create_app sincronismos-processar-agendados --limite 6 >> /tmp/o3cloud-manager-logs/sincronismos-cron.log 2>&1
*/15 * * * * cd /opt/o3cloud-manager && mkdir -p /tmp/o3cloud-manager-logs && O3_LOG_DIR=/tmp/o3cloud-manager-logs /opt/o3cloud-manager/venv/bin/flask --app app:create_app backups-processar-agendados --limite 1 >> /tmp/o3cloud-manager-logs/backups-cron.log 2>&1
*/30 * * * * cd /opt/o3cloud-manager && mkdir -p /tmp/o3cloud-manager-logs && O3_LOG_DIR=/tmp/o3cloud-manager-logs /opt/o3cloud-manager/venv/bin/flask --app app:create_app aso-processar-lembretes --limite 30 >> /tmp/o3cloud-manager-logs/aso-lembretes-cron.log 2>&1
*/15 * * * * cd /opt/o3cloud-manager && mkdir -p /tmp/o3cloud-manager-logs && O3_LOG_DIR=/tmp/o3cloud-manager-logs /opt/o3cloud-manager/venv/bin/flask --app app:create_app operacao-alertas-enviar --limite 30 >> /tmp/o3cloud-manager-logs/operacao-alertas-cron.log 2>&1
0 7 * * * cd /opt/o3cloud-manager && mkdir -p /tmp/o3cloud-manager-logs && O3_LOG_DIR=/tmp/o3cloud-manager-logs /opt/o3cloud-manager/venv/bin/flask --app app:create_app reajustes-processar-alertas >> /tmp/o3cloud-manager-logs/reajustes-cron.log 2>&1
